{
  "name": "threejs-toolkit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "3D Gaussian-splat website toolkit on three.js native splat rendering",
  "scripts": {
    "dev": "npm run build:wasm && vite",
    "pretypecheck": "npm run build:wasm",
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "depcruise src examples --config .dependency-cruiser.cjs",
    "check": "npm run build && npm run check:embed-size && npm run test:crate && npm run typecheck && npm run lint:boundaries",
    "check:embed-size": "node scripts/check-embed-size.mjs",
    "check:full": "npm run check && npm run test:crate:golden",
    "build": "npm run build:site && npm run build:embed",
    "prebuild:site": "npm run build:wasm",
    "build:site": "vite build",
    "prebuild:embed": "npm run build:wasm",
    "build:embed": "vite build --config vite.embed.config.ts",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:wasm": "wasm-pack build rad-three --target web --release",
    "test:crate": "cargo test --release --manifest-path rad-three/Cargo.toml",
    "test:crate:golden": "cargo test --release --manifest-path rad-three/Cargo.toml -- --include-ignored --nocapture"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.x",
    "dependency-cruiser": "^16.10.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
